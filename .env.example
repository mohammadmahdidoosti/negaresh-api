# --- OpenRouter (required) ---
API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Models per pipeline role (defaults shown) ---
LLM_WRITER_MODEL=google/gemini-3.8-flash
LLM_CRITIC_MODEL=openai/gpt-5.6-luna
LLM_REFINER_MODEL=deepseek/deepseek-v4-flash-0731
LLM_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731

# --- Web UI password ---
BETA_ACCESS_SECRET=

# --- Public API (/api/v1) ---
# One key, or several separated by commas. API stays disabled while empty.
NEGARESH_API_KEY=
# Pipelines allowed to run at the same time; extra requests wait in line.
API_MAX_CONCURRENT=2
# Max queued + running jobs before POST /api/v1/jobs answers 429.
API_MAX_PENDING_JOBS=50
# Minutes a finished job's result stays retrievable.
API_JOB_TTL_MINUTES=60

# --- Optional ---
# Max OpenRouter price per 1M tokens (USD); models priced above this are refused.
LLM_MAX_INPUT_PRICE=1
LLM_MAX_OUTPUT_PRICE=5
# Hard spending cap (USD) tracked in the local usage ledger.
LLM_BUDGET_USD=
LLM_USAGE_DB=.local/usage.sqlite
NEXT_PUBLIC_SITE_URL=

# WooCommerce store the content engine reads products from (read-only). Default: https://caravansanat.com
# Not SITE_URL: that one is Negaresh's own address.
STORE_URL=
